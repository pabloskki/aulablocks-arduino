{
  "packageFormat": "aulablocks-sensor",
  "packageVersion": 1,
  "compatibility": [
    "Arduino Uno ATmega328P",
    "Nano ATmega328PB"
  ],
  "id": "motor-controlador-tb6612fng",
  "name": "TB6612FNG · controlador de motores",
  "categoryName": "TB6612FNG",
  "version": "1.0.0",
  "icon": "⚙️",
  "colour": "#287ba7",
  "description": "Controla uno o dos motores DC con velocidad, sentido, parada y freno.",
  "image": {
    "mimeType": "image/svg+xml",
    "encoding": "utf8",
    "alt": "TB6612FNG para proyectos Arduino",
    "data": "<svg xmlns='http://www.w3.org/2000/svg' width='440' height='300' viewBox='0 0 440 300'><rect width='440' height='300' rx='28' fill='#f5f7fb'/><rect x='65' y='42' width='310' height='190' rx='24' fill='#287ba7'/><circle cx='140' cy='137' r='48' fill='#fff' opacity='.88'/><circle cx='300' cy='137' r='48' fill='#fff' opacity='.26'/><path d='M178 137h84M220 95v84' stroke='#fff' stroke-width='12' stroke-linecap='round'/><text x='220' y='272' text-anchor='middle' font-family='Arial' font-size='25' font-weight='700' fill='#25324b'>TB6612FNG</text><text x='220' y='220' text-anchor='middle' font-family='Arial' font-size='18' font-weight='700' fill='#fff'>MOTOR A + B</text></svg>"
  },
  "wiring": {
    "interface": "Puente H doble",
    "uno": [
      "VCC → 5V Arduino",
      "GND → GND común",
      "VM → fuente del motor",
      "STBY → pin digital",
      "AIN1/AIN2/PWMA → pines elegidos",
      "A01/A02 → motor A",
      "BIN1/BIN2/PWMB → pines elegidos",
      "B01/B02 → motor B"
    ],
    "nano328pb": [
      "VCC → 5V Arduino",
      "GND → GND común",
      "VM → fuente del motor",
      "STBY → pin digital",
      "AIN1/AIN2/PWMA → pines elegidos",
      "A01/A02 → motor A",
      "BIN1/BIN2/PWMB → pines elegidos",
      "B01/B02 → motor B"
    ],
    "note": "No conectes el motor directamente al Arduino. Comprueba que la corriente de bloqueo del motor sea segura para el controlador. Los PWM ofrecidos evitan D9/D10 para reducir conflictos al usar Servo."
  },
  "libraries": [],
  "bundledLibraries": [],

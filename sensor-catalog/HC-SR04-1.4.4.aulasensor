      "output": "Boolean",
      "code": "hcsr04MasCercaQue({{TRIG}}, {{ECHO}}, {{DISTANCE}})",
      "tooltip": "Responde sí si detecta un objeto más cerca que los centímetros que elegiste. Por ejemplo, menos de 30 cm. Si no recibe eco, responde no.",
      "codeKind": "expression",
      "hardware": {

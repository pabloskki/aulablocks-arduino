  "bundledLibraries": [],
  "targetAulaBlocksVersion": "0.10.0-beta.5",
  "releaseNotes": "Ayudas para niños al pasar el mouse sobre cada bloque: función, resultado y ejemplos. Sin cambios de código Arduino, pines, bibliotecas ni imágenes."

        },
        {
          "type": "field_dropdown",
          "name": "DIRECTION",
          "options": [
            [
              "avanzar",
              "1"
            ],
            [
              "retroceder",
              "-1"
            ],
            [
              "detener libre",
              "0"
            ],
            [
              "frenar",
              "2"
            ]
          ]
        },
        {
          "type": "field_number",
          "name": "SPEED",
          "value": 150,
          "min": 0,
          "max": 255,
          "precision": 1
        }
      ],
      "code": "controlarTB6612({{IN1}}, {{IN2}}, {{PWM}}, {{STBY}}, {{DIRECTION}}, {{SPEED}});",
      "setup": [
        "pinMode({{IN1}}, OUTPUT);",
        "pinMode({{IN2}}, OUTPUT);",
        "pinMode({{PWM}}, OUTPUT);",
        "pinMode({{STBY}}, OUTPUT);",
        "digitalWrite({{STBY}}, HIGH);"
      ],
      "helpers": [
        "void controlarTB6612(int in1, int in2, int pwm, int stby, int sentido, int velocidad) {\n  velocidad = constrain(velocidad, 0, 255);\n  digitalWrite(stby, HIGH);\n  if (sentido == 0) {\n    digitalWrite(in1, LOW);\n    digitalWrite(in2, LOW);\n    analogWrite(pwm, 0);\n    return;\n  }\n  if (sentido == 2) {\n    digitalWrite(in1, HIGH);\n    digitalWrite(in2, HIGH);\n    analogWrite(pwm, 255);\n    return;\n  }\n  digitalWrite(in1, sentido > 0 ? HIGH : LOW);\n  digitalWrite(in2, sentido > 0 ? LOW : HIGH);\n  analogWrite(pwm, velocidad);\n}"
      ],
      "tooltip": "Controla el canal A del TB6612FNG con velocidad de 0 a 255.",
      "hardware": {
        "deviceKey": [
          "IN1",
          "IN2",
          "PWM"
        ],
        "pins": [
          {
            "field": "IN1",
            "mode": "digital-output"
          },
          {
            "field": "IN2",
            "mode": "digital-output"
          },
          {
            "field": "PWM",
            "mode": "pwm-output"
          },
          {
            "field": "STBY",
            "mode": "digital-output",
            "sharedBus": "tb6612-standby"
          }
        ]
      },
      "codeKind": "statement"
    },

      "helpers": [
        "void controlarTB6612(int in1, int in2, int pwm, int stby, int sentido, int velocidad) {\n  velocidad = constrain(velocidad, 0, 255);\n  digitalWrite(stby, HIGH);\n  if (sentido == 0) {\n    digitalWrite(in1, LOW);\n    digitalWrite(in2, LOW);\n    analogWrite(pwm, 0);\n    return;\n  }\n  if (sentido == 2) {\n    digitalWrite(in1, HIGH);\n    digitalWrite(in2, HIGH);\n    analogWrite(pwm, 255);\n    return;\n  }\n  digitalWrite(in1, sentido > 0 ? HIGH : LOW);\n  digitalWrite(in2, sentido > 0 ? LOW : HIGH);\n  analogWrite(pwm, velocidad);\n}"

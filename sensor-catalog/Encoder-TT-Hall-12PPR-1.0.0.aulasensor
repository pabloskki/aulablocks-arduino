            ],
            [
              "12",
              "12"
            ],
            [
              "13",
              "13"
            ]
          ]
        }
      ],
      "codeKind": "expression",
      "output": "Number",
      "code": "leerCuentaEncoder(encoder_cuenta_{{CHANNEL_A}}_{{CHANNEL_B}})",
      "tooltip": "Entrega pulsos con signo; el signo indica el sentido de giro."
    },
    {
      "includes": [],
      "globals": [
        "volatile long encoder_cuenta_{{CHANNEL_A}}_{{CHANNEL_B}} = 0;",
        "void encoder_isr_{{CHANNEL_A}}_{{CHANNEL_B}}() {\n  encoder_cuenta_{{CHANNEL_A}}_{{CHANNEL_B}} += digitalRead({{CHANNEL_B}}) == HIGH ? 1 : -1;\n}"
      ],
      "setup": [
        "pinMode({{CHANNEL_A}}, INPUT_PULLUP);",
        "pinMode({{CHANNEL_B}}, INPUT_PULLUP);",
        "attachInterrupt(digitalPinToInterrupt({{CHANNEL_A}}), encoder_isr_{{CHANNEL_A}}_{{CHANNEL_B}}, RISING);"
      ],
      "helpers": [
        "long leerCuentaEncoder(volatile long &cuenta) {\n  noInterrupts();\n  long copia = cuenta;\n  interrupts();\n  return copia;\n}"
      ],
      "type": "tt_encoder_revolutions",
      "message0": "vueltas encoder TT · canal A %1 canal B %2 · PPR %3",
      "args0": [
        {
          "type": "field_dropdown",
          "name": "CHANNEL_A",
          "options": [
            [
              "2",

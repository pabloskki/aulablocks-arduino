{
  "packageFormat": "aulablocks-sensor",
  "packageVersion": 1,
  "id": "sensor-nfc-pn532-i2c",
  "name": "Lector NFC PN532 · I2C · Adafruit",
  "version": "1.7.2",
  "icon": "📶",
  "image": {
    "mimeType": "image/svg+xml",
    "encoding": "utf8",
    "alt": "Módulo lector NFC PN532 rojo con antena cuadrada",
    "data": "<svg xmlns='http://www.w3.org/2000/svg' width='440' height='300' viewBox='0 0 440 300'><rect width='440' height='300' rx='28' fill='#eaf9f7'/><rect x='78' y='26' width='284' height='218' rx='18' fill='#c43c35'/><rect x='108' y='55' width='224' height='158' rx='14' fill='none' stroke='#f1c457' stroke-width='11'/><rect x='132' y='79' width='176' height='110' rx='11' fill='none' stroke='#f1c457' stroke-width='8'/><rect x='160' y='103' width='120' height='62' rx='8' fill='none' stroke='#f1c457' stroke-width='6'/><rect x='188' y='119' width='64' height='34' rx='5' fill='#25324b'/><g fill='#d5aa45'><circle cx='102' cy='229' r='5'/><circle cx='126' cy='229' r='5'/><circle cx='150' cy='229' r='5'/><circle cx='174' cy='229' r='5'/></g><text x='220' y='282' text-anchor='middle' font-family='Arial' font-size='24' font-weight='700' fill='#275d65'>NFC PN532 · I2C</text></svg>"
  },
  "colour": "#168c9e",
  "description": "Lee el tipo, el UID y texto NDEF de stickers NFC con la biblioteca Adafruit PN532.",
  "compatibility": [
    "Arduino Uno ATmega328P",
    "Nano ATmega328PB"
  ],
  "wiring": {
    "interface": "I2C de cuatro cables",
    "uno": [
      "VCC → 5V en el módulo Elechouse V3",
      "GND → GND",
      "SDA → A4",
      "SCL → A5"
    ],
    "nano328pb": [
      "VCC → 5V en el módulo Elechouse V3",
      "GND → GND",
      "SDA → A4",
      "SCL → A5"
    ],
    "note": "En el módulo rojo probado, I2C funciona con ambos selectores en 0. Algunos clones imprimen una tabla diferente: conserva la posición con la que el ejemplo de firmware responde. No conectes IRQ ni RSTO."
  },
  "libraries": [
    {
      "name": "Adafruit PN532",
      "version": "1.3.4"
    },
    {
      "name": "Adafruit BusIO",
      "version": "1.17.4"
    }
  ],
  "codeResources": {
    "core": {
      "includes": [
        "#include <Wire.h>",
        "#include <Adafruit_PN532.h>"
      ],
      "globals": [
        "Adafruit_PN532 pn532_i2c(0xFF, 0xFF);",
        "bool pn532_i2c_ok = false;"
      ],
      "setup": [
        "delay(1000);\n  Wire.begin();\n  pn532_i2c.begin();\n  uint32_t versiondata = pn532_i2c.getFirmwareVersion();\n  pn532_i2c_ok = (versiondata != 0);\n  if (pn532_i2c_ok) pn532_i2c.SAMConfig();"
      ]
    },
    "card": {
      "requires": [
        "core"
      ],
      "globals": [
        "uint8_t pn532_uid_cache[7] = {0};",
        "uint8_t pn532_uid_largo_cache = 0;",
        "bool pn532_tarjeta_cache = false;",
        "bool pn532_cache_iniciada = false;",
        "unsigned long pn532_cache_momento = 0;"
      ],
      "helpers": [
        "bool pn532ActualizarTarjeta(Adafruit_PN532 &lector) {\n  unsigned long ahora = millis();\n  if (pn532_cache_iniciada && ahora - pn532_cache_momento < 80UL) return pn532_tarjeta_cache;\n  pn532_cache_iniciada = true;\n  pn532_cache_momento = ahora;\n  pn532_uid_largo_cache = 0;\n  pn532_tarjeta_cache = lector.readPassiveTargetID(PN532_MIFARE_ISO14443A, pn532_uid_cache, &pn532_uid_largo_cache, 120);\n  return pn532_tarjeta_cache;\n}",
        "bool pn532HayTarjeta(Adafruit_PN532 &lector) {\n  return pn532ActualizarTarjeta(lector);\n}"
      ]
    },
    "typeDetect": {
      "requires": [
        "card"
      ],
      "helpers": [
        "uint8_t pn532DetectarTipo(Adafruit_PN532 &lector, uint8_t largoUid) {\n  if (largoUid == 4) return 9;\n  if (largoUid != 7) return 8;\n  uint8_t paginaCapacidad[4] = {0};\n  if (!lector.ntag2xx_ReadPage(3, paginaCapacidad)) return 8;\n  if (paginaCapacidad[0] != 0xE1) return 7;\n  if (paginaCapacidad[2] == 0x12) return 4;\n  if (paginaCapacidad[2] == 0x3E) return 5;\n  if (paginaCapacidad[2] == 0x6D) return 6;\n  return 7;\n}"
      ]
    },
    "typeName": {
      "requires": [
        "typeDetect"
      ],
      "helpers": [
        "String pn532NombreTipo(uint8_t tipo) {\n  if (tipo == 9) return String(\"MIFARE Classic\");\n  if (tipo == 4) return String(\"NTAG213\");\n  if (tipo == 5) return String(\"NTAG215\");\n  if (tipo == 6) return String(\"NTAG216\");\n  if (tipo == 7) return String(\"Ultralight / Type 2\");\n  return String(\"Otra ISO14443A\");\n}",
        "String pn532TipoTarjeta(Adafruit_PN532 &lector) {\n  if (!pn532ActualizarTarjeta(lector)) return String(\"Sin tarjeta\");\n  return pn532NombreTipo(pn532DetectarTipo(lector, pn532_uid_largo_cache));\n}"
      ]
    },
    "uid": {
      "requires": [
        "card"
      ],
      "helpers": [
        "String pn532UidTexto(const uint8_t *uid, uint8_t largo) {\n  String texto;\n  texto.reserve(20);\n  for (uint8_t i = 0; i < largo; i++) {\n    if (i) texto += \" \";\n    if (uid[i] < 0x10) texto += \"0\";\n    texto += String(uid[i], HEX);\n  }\n  texto.toUpperCase();\n  return texto;\n}",
        "String pn532UidTarjeta(Adafruit_PN532 &lector) {\n  if (!pn532ActualizarTarjeta(lector)) return String(\"\");\n  return pn532UidTexto(pn532_uid_cache, pn532_uid_largo_cache);\n}"
      ]
    },
    "text": {
      "requires": [
        "typeDetect"
      ],
      "helpers": [
        "bool pn532LeerByteType2(Adafruit_PN532 &lector, uint16_t posicion, uint8_t &valor, uint8_t &paginaCache, uint8_t cache[4]) {\n  uint8_t pagina = 4 + posicion / 4;\n  if (pagina != paginaCache) {\n    if (!lector.ntag2xx_ReadPage(pagina, cache)) return false;\n    paginaCache = pagina;\n  }\n  valor = cache[posicion % 4];\n  return true;\n}",
        "uint16_t pn532CapacidadType2(uint8_t tipo) {\n  if (tipo == 4) return 144;\n  if (tipo == 5) return 496;\n  if (tipo == 6) return 872;\n  return 144;\n}",
        "String pn532LeerTextoNdef(Adafruit_PN532 &lector, uint16_t capacidad) {\n  uint8_t cache[4] = {0};\n  uint8_t paginaCache = 0xFF;\n  uint8_t valor = 0;\n  uint16_t pos = 0;\n  uint32_t largoNdef = 0;\n  bool encontrado = false;\n  while (pos < capacidad) {\n    if (!pn532LeerByteType2(lector, pos++, valor, paginaCache, cache)) return String(\"\");\n    if (valor == 0x00) continue;\n    if (valor == 0xFE) return String(\"\");\n    uint8_t tipoTlv = valor;\n    if (!pn532LeerByteType2(lector, pos++, valor, paginaCache, cache)) return String(\"\");\n    largoNdef = valor;\n    if (largoNdef == 0xFF) {\n      uint8_t alto = 0;\n      uint8_t bajo = 0;\n      if (!pn532LeerByteType2(lector, pos++, alto, paginaCache, cache)) return String(\"\");\n      if (!pn532LeerByteType2(lector, pos++, bajo, paginaCache, cache)) return String(\"\");\n      largoNdef = (uint16_t(alto) << 8) | bajo;\n    }\n    if (tipoTlv == 0x03) {\n      encontrado = true;\n      break;\n    }\n    if (uint32_t(pos) + largoNdef > capacidad) return String(\"\");\n    pos += uint16_t(largoNdef);\n  }\n  if (!encontrado) return String(\"\");\n  uint32_t finNdef = min(uint32_t(capacidad), uint32_t(pos) + largoNdef);\n  while (uint32_t(pos) + 3 < finNdef) {\n    uint8_t cabecera = 0;\n    uint8_t largoTipo = 0;\n    if (!pn532LeerByteType2(lector, pos++, cabecera, paginaCache, cache)) return String(\"\");\n    if (!pn532LeerByteType2(lector, pos++, largoTipo, paginaCache, cache)) return String(\"\");\n    bool registroCorto = (cabecera & 0x10) != 0;\n    bool tieneId = (cabecera & 0x08) != 0;\n    uint32_t largoContenido = 0;\n    if (registroCorto) {\n      if (!pn532LeerByteType2(lector, pos++, valor, paginaCache, cache)) return String(\"\");\n      largoContenido = valor;\n    } else {\n      for (uint8_t i = 0; i < 4; i++) {\n        if (!pn532LeerByteType2(lector, pos++, valor, paginaCache, cache)) return String(\"\");\n        largoContenido = (largoContenido << 8) | valor;\n      }\n    }\n    uint8_t largoId = 0;\n    if (tieneId && !pn532LeerByteType2(lector, pos++, largoId, paginaCache, cache)) return String(\"\");\n    if (uint32_t(pos) + largoTipo + largoId + largoContenido > finNdef) return String(\"\");\n    uint8_t primerTipo = 0;\n    if (largoTipo && !pn532LeerByteType2(lector, pos, primerTipo, paginaCache, cache)) return String(\"\");\n    bool esTexto = (cabecera & 0x07) == 0x01 && largoTipo == 1 && primerTipo == 'T';\n    pos += largoTipo + largoId;\n    if (esTexto && largoContenido > 1) {\n      uint8_t estado = 0;\n      if (!pn532LeerByteType2(lector, pos, estado, paginaCache, cache)) return String(\"\");\n      uint8_t largoIdioma = estado & 0x3F;\n      if ((estado & 0x80) != 0 || uint32_t(1 + largoIdioma) >= largoContenido) return String(\"\");\n      uint32_t largoTexto = largoContenido - 1 - largoIdioma;\n      String texto;\n      if (!texto.reserve(largoTexto)) return String(\"[Texto demasiado largo para la memoria del Arduino]\");\n      uint32_t inicioTexto = uint32_t(pos) + 1 + largoIdioma;\n      for (uint32_t i = 0; i < largoTexto; i++) {\n        if (!pn532LeerByteType2(lector, uint16_t(inicioTexto + i), valor, paginaCache, cache)) return String(\"\");\n        texto += char(valor);\n      }\n      return texto;\n    }\n    pos += uint16_t(largoContenido);\n  }\n  return String(\"\");\n}",
        "String pn532TextoTarjeta(Adafruit_PN532 &lector) {\n  if (!pn532ActualizarTarjeta(lector)) return String(\"\");\n  uint8_t tipo = pn532DetectarTipo(lector, pn532_uid_largo_cache);\n  if (tipo < 4 || tipo > 7) return String(\"\");\n  return pn532LeerTextoNdef(lector, pn532CapacidadType2(tipo));\n}"
      ]
    }
  },
  "blocks": [
    {
      "type": "pn532_adafruit_reader_active",
      "requires": [
        "core"
      ],
      "message0": "lector PN532 I2C está activado",
      "output": "Boolean",
      "code": "pn532_i2c_ok",
      "tooltip": "Es verdadero cuando el PN532 respondió y quedó listo para leer tarjetas.",
      "args0": [],
      "codeKind": "expression"
    },
    {
      "type": "pn532_adafruit_card_present",
      "requires": [
        "card"
      ],
      "message0": "hay una tarjeta NFC",
      "output": "Boolean",
      "code": "pn532_i2c_ok && pn532HayTarjeta(pn532_i2c)",
      "tooltip": "Es verdadero mientras una tarjeta compatible está frente al lector.",
      "args0": [],
      "codeKind": "expression"
    },
    {
      "type": "pn532_adafruit_tag_type",
      "requires": [
        "typeName"
      ],
      "message0": "tipo de tarjeta NFC",
      "output": "String",
      "code": "pn532_i2c_ok ? pn532TipoTarjeta(pn532_i2c) : String(\"Lector desconectado\")",
      "tooltip": "Devuelve NTAG213, NTAG215, NTAG216, Ultralight/Type 2, MIFARE Classic u otra ISO14443A.",
      "args0": [],
      "codeKind": "expression"
    },
    {
      "type": "pn532_adafruit_uid_any",
      "requires": [
        "uid"
      ],
      "message0": "UID de la tarjeta NFC",
      "output": "String",
      "code": "pn532_i2c_ok ? pn532UidTarjeta(pn532_i2c) : String(\"\")",
      "tooltip": "Detecta automáticamente la tarjeta y entrega su UID hexadecimal.",
      "args0": [],
      "codeKind": "expression"
    },
    {
      "type": "pn532_adafruit_text_any",
      "requires": [
        "text"
      ],
      "message0": "texto escrito en la tarjeta NFC",
      "output": "String",
      "code": "pn532_i2c_ok ? pn532TextoTarjeta(pn532_i2c) : String(\"\")",
      "tooltip": "Reconoce automáticamente NTAG213, NTAG215, NTAG216 o Ultralight y lee su primer texto NDEF.",
      "args0": [],
      "codeKind": "expression"
    }
  ],

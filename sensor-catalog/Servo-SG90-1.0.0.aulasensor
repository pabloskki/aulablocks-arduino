{
  "packageFormat": "aulablocks-sensor",
  "packageVersion": 1,
  "compatibility": [
    "Arduino Uno ATmega328P",
    "Nano ATmega328PB"
  ],
  "id": "actuador-servo-sg90",
  "name": "Servo SG90 / MG90S",
  "categoryName": "Servo SG90",
  "version": "1.0.0",
  "icon": "🦾",
  "colour": "#e1822f",
  "description": "Mueve servos educativos de posición entre 0 y 180 grados.",
  "image": {
    "mimeType": "image/svg+xml",
    "encoding": "utf8",
    "alt": "SERVO SG90 para proyectos Arduino",
    "data": "<svg xmlns='http://www.w3.org/2000/svg' width='440' height='300' viewBox='0 0 440 300'><rect width='440' height='300' rx='28' fill='#f5f7fb'/><rect x='65' y='42' width='310' height='190' rx='24' fill='#e1822f'/><circle cx='140' cy='137' r='48' fill='#fff' opacity='.88'/><circle cx='300' cy='137' r='48' fill='#fff' opacity='.26'/><path d='M178 137h84M220 95v84' stroke='#fff' stroke-width='12' stroke-linecap='round'/><text x='220' y='272' text-anchor='middle' font-family='Arial' font-size='25' font-weight='700' fill='#25324b'>SERVO SG90</text><text x='220' y='220' text-anchor='middle' font-family='Arial' font-size='18' font-weight='700' fill='#fff'>0° — 180°</text></svg>"
  },
  "wiring": {
    "interface": "Señal PWM de servo",
    "uno": [
      "Rojo/VCC → fuente de 5V adecuada",
      "Café o negro/GND → GND común",
      "Naranjo o amarillo/SEÑAL → pin digital elegido"
    ],
    "nano328pb": [
      "Rojo/VCC → fuente de 5V adecuada",
      "Café o negro/GND → GND común",
      "Naranjo o amarillo/SEÑAL → pin digital elegido"
    ],
    "note": "No alimentes varios servos desde el pin 5V del Arduino. Usa una fuente externa de 5V y une sus GND."
  },
  "libraries": [
    {
      "name": "Servo",
      "version": "1.3.0"
    }
  ],
  "bundledLibraries": [

  "blocks": [
    {
      "type": "servo_sg90_angle",
      "message0": "mover servo SG90 · SEÑAL %1 · ángulo %2°",
      "args0": [
        {
          "type": "field_dropdown",
          "name": "PIN",
          "options": [
            [
              "4",
              "4"
            ],
            [
              "2",
              "2"
            ],
            [
              "3",
              "3"
            ],
            [
              "5",
              "5"
            ],
            [
              "6",
              "6"
            ],
            [
              "7",
              "7"
            ],
            [
              "8",
              "8"
            ],
            [
              "9",
              "9"
            ],
            [
              "10",
              "10"
            ],
            [
              "11",
              "11"
            ],
            [
              "12",
              "12"
            ],
            [
              "13",
              "13"
            ]
          ]
        },
        {
          "type": "field_number",
          "name": "ANGLE",
          "value": 90,
          "min": 0,
          "max": 180,
          "precision": 1
        }
      ],
      "code": "servo_sg90_{{PIN}}.write({{ANGLE}});",
      "includes": [
        "#include <Servo.h>"
      ],
      "globals": [
        "Servo servo_sg90_{{PIN}};"
      ],
      "setup": [
        "servo_sg90_{{PIN}}.attach({{PIN}});"
      ],
      "tooltip": "Mueve el servo al ángulo indicado.",
      "hardware": {
        "deviceKey": [
          "PIN"
        ],
        "pins": [
          {
            "field": "PIN",
            "mode": "digital-output"
          }
        ]
      },
      "codeKind": "statement"
    }
  ],
  "targetAulaBlocksVersion": "0.10.0-beta.5",
  "releaseNotes": "Imagen ilustrada reconocible incluida para uso sin internet. Sin cambios de bloques, código, pines ni bibliotecas."
}
